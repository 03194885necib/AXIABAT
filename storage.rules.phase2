// PHASE 2 — PROPOSITION NON DEPLOYEE.
// Protège les fichiers de project_files à partir du profil Firestore users/{uid}.
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function hasActiveProfile() {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.get('actif', false) == true;
    }

    function canWriteProjectFiles() {
      return hasActiveProfile()
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.get('role', '')
          in ['admin', 'chef_projet', 'conducteur'];
    }

    function allowedProjectFile() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'image/jpeg',
          'image/png',
          'image/webp',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'text/csv'
        ];
    }

    match /project_files/{projectId}/{type}/{fileName} {
      allow read: if hasActiveProfile();
      allow create, update: if canWriteProjectFiles() && allowedProjectFile();
      allow delete: if canWriteProjectFiles();

      // VARIANTE À CHOISIR — NON ACTIVE :
      // Pour inclure DWG/DXF et ZIP et relever la limite à 25 Mio, remplacer
      // allowedProjectFile() par la fonction ci-dessous. Les MIME DWG/DXF
      // varient selon les systèmes; ne pas ajouter application/octet-stream,
      // qui autoriserait aussi des fichiers inconnus.
      /*
      function allowedProjectFile25MiB() {
        return request.resource != null
          && request.resource.size <= 25 * 1024 * 1024
          && request.resource.contentType in [
            'application/pdf',
            'image/jpeg',
            'image/png',
            'image/webp',
            'application/msword',
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
            'application/vnd.ms-excel',
            'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
            'text/csv',
            'application/acad',
            'application/x-acad',
            'application/dwg',
            'application/x-dwg',
            'image/vnd.dwg',
            'image/x-dwg',
            'application/dxf',
            'application/x-dxf',
            'image/vnd.dxf',
            'image/x-dxf',
            'application/zip',
            'application/x-zip-compressed'
          ];
      }
      */
    }
  }
}
