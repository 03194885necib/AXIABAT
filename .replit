modules = ["web", "nodejs-20", "python-base-3.13"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
PORT = "5000"
HOST = "0.0.0.0"
DANGEROUSLY_DISABLE_HOST_CHECK = "true"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "HOST=0.0.0.0 PORT=5000 BROWSER=none npm start"

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000

[[ports]]
localPort = 5001

[deployment]
deploymentTarget = "static"
build = ["npm", "run", "build"]
publicDir = "build"
