// PHASE 2 — PROPOSITION NON DEPLOYEE.
// Base : firestore.rules.proposed approuvee.
// Les règles users et logs_activite sont conservées.
// Les autres chemins exigent un compte actif; seules les écritures métier
// sont permises aux rôles admin, chef_projet et conducteur.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasActiveAccount() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.get('actif', true) == true;
    }

    function isAdmin() {
      return hasActiveAccount()
        && get(userPath(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // Phase 2 requires an explicit actif: true for access to business data.
    function hasActiveBusinessAccount() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.get('actif', false) == true;
    }

    function canWriteBusiness() {
      return hasActiveBusinessAccount()
        && get(userPath(request.auth.uid)).data.get('role', '')
          in ['admin', 'chef_projet', 'conducteur'];
    }

    function validRole(role) {
      return role in ['admin', 'chef_projet', 'conducteur', 'viewer'];
    }

    function logRoleChangeMatchesAccount() {
      let detail = request.resource.data.get('détail', {});
      let targetUid = detail.get('targetUid', '');
      let targetPath = userPath(targetUid);

      return detail.keys().hasAll(['targetUid', 'previousRole', 'newRole'])
        && detail.keys().hasOnly(['targetUid', 'previousRole', 'newRole'])
        && targetUid is string
        && targetUid != request.auth.uid
        && validRole(detail.get('previousRole', ''))
        && validRole(detail.get('newRole', ''))
        && exists(targetPath)
        && get(targetPath).data.get('role', '') == detail.previousRole
        && existsAfter(targetPath)
        && getAfter(targetPath).data.get('role', '') == detail.newRole;
    }

    function logStatusChangeMatchesAccount(expectedStatus) {
      let detail = request.resource.data.get('détail', {});
      let targetUid = detail.get('targetUid', '');
      let targetPath = userPath(targetUid);

      return detail.keys().hasAll(['targetUid', 'actif'])
        && detail.keys().hasOnly(['targetUid', 'actif'])
        && targetUid is string
        && targetUid != request.auth.uid
        && detail.actif is bool
        && detail.actif == expectedStatus
        && exists(targetPath)
        && get(targetPath).data.get('actif', true) != detail.actif
        && existsAfter(targetPath)
        && getAfter(targetPath).data.get('actif', false) == detail.actif;
    }

    function validActivityLog() {
      return request.resource.data.keys().hasAll(['uid', 'action', 'date', 'détail'])
        && request.resource.data.keys().hasOnly(['uid', 'action', 'date', 'détail'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.date is timestamp
        && request.resource.data.get('détail', {}) is map
        && (
          (
            request.resource.data.action == 'ROLE_CHANGED'
            && logRoleChangeMatchesAccount()
          )
          || (
            request.resource.data.action == 'ACCOUNT_ACTIVATED'
            && logStatusChangeMatchesAccount(true)
          )
          || (
            request.resource.data.action == 'ACCOUNT_DEACTIVATED'
            && logStatusChangeMatchesAccount(false)
          )
        );
    }

    // Conservé du brouillon validé.
    match /users/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if (
          isAdmin()
          && uid != request.auth.uid
          && validRole(request.resource.data.get('role', ''))
          && request.resource.data.get('actif', true) is bool
        ) || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.get('role', '') == 'viewer'
          && request.resource.data.get('actif', false) == true
        );

      allow update: if (
          isAdmin()
          && uid != request.auth.uid
          && validRole(request.resource.data.get('role', ''))
          && request.resource.data.get('actif', resource.data.get('actif', true)) is bool
        ) || (
          hasActiveAccount()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'updatedAt'])
        );

      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // Conservé du brouillon validé : création uniquement, sans modification
    // ni suppression; la création accompagne le changement de compte en batch.
    match /logs_activite/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && validActivityLog();
      allow update, delete: if false;
    }

    // All other roots (business collections and their subcollections):
    // active accounts may read; only active writers may create/update/delete.
    // Excluding users/logs prevents this recursive match from widening access.
    match /{collectionName}/{document=**} {
      allow read: if collectionName != 'users'
        && collectionName != 'logs_activite'
        && hasActiveBusinessAccount();
      allow write: if collectionName != 'users'
        && collectionName != 'logs_activite'
        && canWriteBusiness();
    }
  }
}
